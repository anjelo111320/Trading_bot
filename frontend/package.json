{
  "name": "trading-intel-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o /tmp/schema-check.d.ts && diff /tmp/schema-check.d.ts src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "lightweight-charts": "5.2.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.2.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
