# Copy to .env. Never commit .env.

# Anthropic. Needed from Phase 7 only.
ANTHROPIC_API_KEY=

# News. Optional, needed from Phase 6 only.
FINNHUB_API_KEY=
NEWSDATA_API_KEY=

# Market data. Public endpoints only: no exchange keys exist in this project.
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
BINANCE_USDM_REST_URL=https://fapi.binance.com
BINANCE_USDM_WS_URL=wss://fstream.binance.com

# Database. Local development values only. The port avoids the Homebrew PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://ati_app:local_dev_only@127.0.0.1:55432/trading
INGEST_DATABASE_URL=postgresql+asyncpg://ati_ingest:local_dev_only@127.0.0.1:55432/trading
MIGRATION_DATABASE_URL=postgresql+asyncpg://ati_migrator:local_dev_only@127.0.0.1:55432/trading

# Redis
REDIS_URL=redis://127.0.0.1:56379/0

# Application
APP_ENV=development
APP_SECRET_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Owner login. Set once, then used to create the single owner account.
OWNER_EMAIL=
OWNER_PASSWORD=

# Trading safety. Paper trading is the only mode and has no setting.
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MIN_REWARD_RISK=2.0
