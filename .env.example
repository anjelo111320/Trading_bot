# Copy to .env. Never commit .env.

# Anthropic. Needed from Phase 7 only.
ANTHROPIC_API_KEY=

# News. Optional, needed from Phase 6 only.
# Finnhub: a free personal key from finnhub.io, for its crypto news. Empty keeps it off.
FINNHUB_API_KEY=
NEWSDATA_API_KEY=
# Binance announcements (D032): an HMAC key from your main Binance account with only "Enable
# Reading" ticked, ideally restricted to your IP. It is used only for the announcement stream.
# A key that can trade, withdraw or transfer is refused before any connection. Empty keeps it off.
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=

# Binance demo trading (D048): test funds only, from demo.binance.com > Demo Trading API.
# Recommended: run `binance_demo keygen`, register its public key as a Self-generated key, and
# set only the API key. The private key stays in ~/.config/trading-intel, never in this file.
# A System-generated key also works: set its secret too. Leave the key empty to keep it off.
# The code only ever calls https://demo-fapi.binance.com, so these cannot reach real money.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Market data. Public endpoints only. The only real-account key is the read-only one above.
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
BINANCE_USDM_REST_URL=https://fapi.binance.com
BINANCE_USDM_WS_URL=wss://fstream.binance.com

# Database. Local development values only. The port avoids the Homebrew PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://ati_app:local_dev_only@127.0.0.1:55432/trading
INGEST_DATABASE_URL=postgresql+asyncpg://ati_ingest:local_dev_only@127.0.0.1:55432/trading
MIGRATION_DATABASE_URL=postgresql+asyncpg://ati_migrator:local_dev_only@127.0.0.1:55432/trading

# Redis
REDIS_URL=redis://127.0.0.1:56379/0

# Application
APP_ENV=development
APP_SECRET_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Owner login. Set once, then used to create the single owner account.
OWNER_EMAIL=
OWNER_PASSWORD=

# Trading safety. Paper trading is the only mode and has no setting.
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MIN_REWARD_RISK=2.0
