    "/api/v1/market/candles": {
      "get": {
        "operationId": "candles_api_v1_market_candles_get",
        "parameters": [
          {
            "in": "query",
            "name": "provider",
            "required": true,
            "schema": {
              "maxLength": 40,
              "minLength": 1,
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Instrument Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "timeframe",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Timeframe"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandlePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Candles",
        "tags": [
          "market"
        ]
      }
    },
